# String de conexão do MongoDB (local ou MongoDB Atlas)
# Exemplo local: mongodb://127.0.0.1:27017/gestor-financeiro
# Exemplo Atlas: mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/gestor-financeiro?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/gestor-financeiro

# Porta onde a API Node.js vai rodar
PORT=3000
